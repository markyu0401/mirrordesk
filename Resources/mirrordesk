#!/bin/zsh
# mirrordesk — connect to the phone and hand off to scrcpy.
#
# macOS wireless-ADB has three traps this script handles so you never have to
# restart the adb server by hand:
#   1. adb's bundled mDNS responder contends with macOS's own mDNSResponder for
#      UDP 5353, so `adb mdns services` often comes back empty.  -> discover the
#      phone's rotating port with macOS's own Bonjour tool (dns-sd) instead.
#   2. macOS Local Network privacy can deny adb's TCP to LAN IPs ("No route to
#      host") when adb was started by an app without that permission (e.g. sshd).
#      -> fall back to the phone's Tailscale IP, which is not gated.
#   3. Transports wedge after the phone's Wi-Fi sleeps: adb still lists them as
#      "device" but any transfer dies with "connect failed: closed" / "offline".
#      -> probe with a real shell round-trip, not `get-state`, and restart the
#      adb server automatically (once) if every candidate is wedged.
# The last working address is cached, so day-to-day runs skip discovery.
#
# Usage:
#   mirrordesk                            # cached address, else auto-discover
#   mirrordesk --check                    # resolve + print device, don't launch
#   mirrordesk 192.168.1.23:37123        # explicit address
#   mirrordesk --usb                      # USB-attached device
#   mirrordesk --pair <IP>:<PAIR_PORT>    # one-time wireless pairing
#   mirrordesk <serial> --turn-screen-off --no-audio   # extra scrcpy flags

set -e
ADB="${ADB:-/opt/homebrew/bin/adb}"
SCRCPY="${SCRCPY:-/opt/homebrew/bin/scrcpy}"
TS_BIN="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
STATE="$HOME/.local/share/mirrordesk/state"
mkdir -p "${STATE:h}"

say() { print -r -- "$@" }
state_get() { [[ -f "$STATE" ]] && sed -n "s/^$1=//p" "$STATE" | tail -1 || true }
state_set() {
  local k="$1" v="$2" tmp="$STATE.tmp"
  { grep -v "^$k=" "$STATE" 2>/dev/null || true } > "$tmp"
  print -r -- "$k=$v" >> "$tmp"
  mv "$tmp" "$STATE"
}

# Real round-trip: get-state lies about wedged transports.
probe() {
  perl -e 'alarm 6; exec @ARGV' "$ADB" -s "$1" shell echo ok >/dev/null 2>&1
}

try_addr() {
  local addr="$1"
  probe "$addr" && return 0
  "$ADB" disconnect "$addr" >/dev/null 2>&1 || true
  "$ADB" connect "$addr" >/dev/null 2>&1 || true
  sleep 0.6
  probe "$addr"
}

tailscale_ip() {
  local cached; cached="$(state_get ts)"
  [[ -n "$cached" ]] && { print -r -- "$cached"; return 0; }
  [[ -x "$TS_BIN" ]] || return 1
  "$TS_BIN" status 2>/dev/null | awk '/android/ {print $1; exit}'
}

# Prints "<port> <lan-ip>" using macOS Bonjour (dns-sd), bypassing adb's mDNS.
bonjour_discover() {
  local inst line port host ip
  inst=$( ( dns-sd -B _adb-tls-connect._tcp local. & p=$!; sleep 3; kill $p 2>/dev/null ) 2>/dev/null \
            | awk '/Add/ && /_adb-tls-connect/ {print $NF; exit}' ) || true
  [[ -z "$inst" ]] && return 1
  line=$( ( dns-sd -L "$inst" _adb-tls-connect._tcp local. & p=$!; sleep 3; kill $p 2>/dev/null ) 2>/dev/null \
            | awk '/can be reached at/ {print; exit}' ) || true
  port=$(print -r -- "$line" | sed -n 's/.*:\([0-9][0-9]*\) .*/\1/p')
  [[ -z "$port" ]] && return 1
  host=$(print -r -- "$line" | sed -n 's/.* at \([^ ]*\):[0-9][0-9]* .*/\1/p')
  ip=""
  if [[ -n "$host" ]]; then
    ip=$( ( dns-sd -G v4 "$host" & p=$!; sleep 2; kill $p 2>/dev/null ) 2>/dev/null \
           | awk '/Add/ && /\.local\./ {print $(NF-1); exit}' ) || true
  fi
  print -r -- "$port ${ip:-}"
}

# Generic Bonjour browse: prints "<port> <ip>"; optional name prefix filter.
bonjour_discover_type() {
  local type="$1" match="${2:-}" inst line port host ip
  inst=$( ( dns-sd -B "$type" local. & p=$!; sleep 3; kill $p 2>/dev/null ) 2>/dev/null \
            | awk -v m="$match" '/Add/ && /_adb-tls/ && (m=="" || $0 ~ m) {print $NF; exit}' ) || true
  [[ -z "$inst" ]] && return 1
  line=$( ( dns-sd -L "$inst" "$type" local. & p=$!; sleep 3; kill $p 2>/dev/null ) 2>/dev/null \
            | awk '/can be reached at/ {print; exit}' ) || true
  port=$(print -r -- "$line" | sed -n 's/.*:\([0-9][0-9]*\) .*/\1/p')
  [[ -z "$port" ]] && return 1
  host=$(print -r -- "$line" | sed -n 's/.* at \([^ ]*\):[0-9][0-9]* .*/\1/p')
  ip=""
  if [[ -n "$host" ]]; then
    ip=$( ( dns-sd -G v4 "$host" & p=$!; sleep 2; kill $p 2>/dev/null ) 2>/dev/null \
           | awk '/Add/ && /\.local\./ {print $(NF-1); exit}' ) || true
  fi
  print -r -- "$port ${ip:-}"
}

# QR pairing: the phone advertises _adb-tls-pairing._tcp after scanning the QR.
pair_qr() {
  local service="$1" password="$2" disc port ip addr i
  say "Waiting for the phone to scan the QR code…"
  ip=""
  for i in {1..20}; do
    disc="$(bonjour_discover_type _adb-tls-pairing._tcp "$service" || true)"
    port="${disc%% *}"
    ip="${disc#* }"
    [[ "$ip" == "$disc" ]] && ip=""
    if [[ -n "$port" && -n "$ip" ]]; then
      say "→ pairing service at $ip:$port"
      if "$ADB" pair "$ip:$port" "$password" 2>&1 | grep -q "Successfully paired"; then
        say "Paired!"
        break
      fi
    fi
    sleep 2
  done
  [[ -z "$ip" ]] && { say "Pairing timed out."; return 1; }
  say "→ waiting for the connect service…"
  for i in {1..20}; do
    disc="$(bonjour_discover_type _adb-tls-connect._tcp "" || true)"
    port="${disc%% *}"
    ip="${disc#* }"
    [[ "$ip" == "$disc" ]] && ip=""
    if [[ -n "$port" && -n "$ip" ]]; then
      if "$ADB" connect "$ip:$port" 2>&1 | grep -q "connected"; then
        addr="$ip:$port"
        state_set serial "$addr"
        state_set port "$port"
        state_set lan "$ip"
        say "Connected: $addr"
        return 0
      fi
    fi
    sleep 2
  done
  say "Paired, but no connect service was found. Use Connect to address…"
  return 1
}

# --- args -------------------------------------------------------------------
PAIR="" ; USB=0 ; CHECK=0 ; SER_ARG="" ; EXTRA=()
PAIR_QR=0 ; PAIR_QR_SERVICE="" ; PAIR_QR_PASSWORD=""
while (( $# )); do
  case "$1" in
    --pair)  PAIR="$2"; shift 2 ;;
    --pair-qr) PAIR_QR=1; PAIR_QR_SERVICE="$2"; PAIR_QR_PASSWORD="$3"; shift 3 ;;
    --usb)   USB=1; shift ;;
    --check) CHECK=1; shift ;;
    -*)      EXTRA+=("$1"); shift ;;
    *)       if [[ -z "$SER_ARG" ]]; then SER_ARG="$1"; else EXTRA+=("$1"); fi; shift ;;
  esac
done

if [[ -n "$PAIR" ]]; then
  printf "Enter the 6-digit code shown on the phone: "
  read CODE
  "$ADB" pair "$PAIR" "$CODE"
  exit $?
fi

if (( PAIR_QR )); then
  pair_qr "$PAIR_QR_SERVICE" "$PAIR_QR_PASSWORD"
  exit $?
fi

resolve_once() {
  local cached disc port lan ts mdns_addr addr
  cached="$(state_get serial)"
  if [[ -n "$cached" ]] && try_addr "$cached"; then print -r -- "$cached"; return 0; fi

  disc="$(bonjour_discover || true)"
  port="${disc%% *}"
  lan="${disc#* }"
  [[ "$lan" == "$disc" ]] && lan=""       # no ip resolved
  ts="$(tailscale_ip || true)"
  mdns_addr="$("$ADB" mdns services 2>/dev/null | awk '/_adb-tls-connect/ {print $NF; exit}' || true)"

  for addr in ${lan:+$lan:$port} ${ts:+$ts:$port} ${mdns_addr:-}; do
    [[ -z "$addr" ]] && continue
    if try_addr "$addr"; then
      state_set serial "$addr"
      [[ -n "$port" ]] && state_set port "$port"
      [[ -n "$lan" ]] && state_set lan "$lan"
      [[ -n "$ts" ]] && state_set ts "$ts"
      print -r -- "$addr"; return 0
    fi
  done
  return 1
}

SER=""
if (( USB )); then
  SER="$("$ADB" devices | awk 'NR>1 && $2=="device" && $1 !~ /:/ {print $1; exit}')"
  [[ -z "$SER" ]] && SER="$("$ADB" devices | awk 'NR>1 && $2=="device" {print $1; exit}')"
elif [[ -n "$SER_ARG" ]]; then
  if try_addr "$SER_ARG"; then
    SER="$SER_ARG"
  else
    say "✗ cannot reach $SER_ARG (check the port in Wireless debugging)"
    exit 2
  fi
else
  say "→ resolving phone (cache → Bonjour → Tailscale)…"
  SER="$(resolve_once || true)"
fi

# Last resort: the adb server itself is wedged. Restart it once and retry.
if [[ -z "$SER" ]]; then
  if pgrep -x scrcpy >/dev/null 2>&1; then
    say "scrcpy is already running — not restarting the adb server."
    exit 0
  fi
  say "→ all transports wedged; restarting adb server and retrying…"
  "$ADB" kill-server >/dev/null 2>&1 || true
  sleep 1
  "$ADB" start-server >/dev/null 2>&1 || true
  sleep 2
  SER="$(resolve_once || true)"
fi

if [[ -z "$SER" ]]; then
  cat <<'EOF'
No device found.
  USB:      plug the phone in with USB debugging on, then run:  mirrordesk --usb
  Wireless: Settings → Developer options → Wireless debugging shows IP:PORT.  First time on this Mac:
            mirrordesk --pair <IP>:<PAIRING_PORT>   (code from the phone)
            then mirrordesk <IP>:<PORT>
EOF
  exit 1
fi

if (( CHECK )); then
  say "device: $SER"
  "$ADB" -s "$SER" shell getprop ro.product.model 2>/dev/null || true
  exit 0
fi

QUALITY=(--max-fps=120 --video-codec=h264)
# Wireless: sharper + smoother than the old 1600p/12M/60fps defaults.
# --video-buffer trades ~100 ms of latency for far fewer dropped frames.
[[ "$SER" == *.*:* ]] && QUALITY+=(--max-size=1920 --video-bit-rate=${VIDEO_BIT_RATE:-24M} --video-buffer=${VIDEO_BUFFER:-100})

export ADB PATH="/opt/homebrew/bin:$PATH"
exec "$SCRCPY" -s "$SER" "${QUALITY[@]}" \
  --window-title="${WINDOW_TITLE:-Samsung phone}" --stay-awake \
  "${EXTRA[@]}"
